#pragma once

// Create LOCAL include/probe_private.h from this example.
// Never commit your real Edge hostname/IP, Core details or credentials.
#define PROBE_EDGE_HOST "CHANGE_ME_EDGE_HOST"
#define PROBE_EDGE_PORT 2252
// Independently verify the negotiated Core SSH host public key via the Edge.
// 64 lowercase hex chars of the SHA256(raw public-key blob); no colon/base64.
#define PROBE_SSH_PIN_SHA256_HEX ""

// On many ESP32 DevKit boards the small controllable LED is GPIO2.
// Some ESP32-D0WD boards have no onboard programmable LED or use another pin.
// Change these in the ignored local file if necessary.
#define PROBE_LED_PIN 2
#define PROBE_LED_ACTIVE_LOW 0

// R3 Phase 2: opt-in only. The default remains OFF, including for all users.
// Mode 0 = existing public-key Deep experiment; mode 1 = A1 password Deep.
// Keep Deep OFF unless explicitly conducting an authorized A2 pilot.
// Place REAL credentials only in the ignored local probe_private.h file.
// Passwords embedded in ESP32 flash are extractable with physical access.
// Do not put customer credentials or secrets in the repo, Serial or PR.
#define PROBE_DEEP_ENABLED 0
#define PROBE_DEEP_AUTH_MODE 1 // 1=password; 0=legacy public-key
#define PROBE_DEEP_USER ""
#define PROBE_DEEP_PASSWORD "" // LOCAL ignored file ONLY
#define PROBE_DEEP_AUTH_ONLY 1 // A2: prove password first; NO forwarding
// Set AUTH_ONLY to 0 only after a forwarding target is explicitly approved.
#define PROBE_DEEP_PRIVATE_KEY_B64 "" // only for mode 0
#define PROBE_DEEP_REMOTE_HOST "127.0.0.1"
#define PROBE_DEEP_REMOTE_PORT 18180
#define PROBE_DEEP_SAMPLE_BYTES 16384UL
#define PROBE_DEEP_DWELL_MS 20000UL
#define PROBE_DEEP_EVERY_N_CYCLES 2

// B1 field gate (later, after the Core responder + forwarding path are proven):
// explicitly change PROBE_DEEP_AUTH_ONLY from 1 to 0 only for the B1 build.
// Keep PROBE_DEEP_REMOTE_HOST="127.0.0.1", PORT=18180, SAMPLE_BYTES=16384,
// DWELL_MS=20000. No general outbound proxy, no arbitrary SSH forwarding.

// B2 after Core rollout: same explicit B1 forwarding settings, but build the
// B2-only environment to emit signed z.rt=1 (CORE_LOOPBACK) + z.f/z.g.
// Never treat Core-loopback success as NPV customer internet egress.

// B3 MCI Edge-auth: set PROBE_DEEP_AUTH_ONLY back to 1 in your ignored
// local header. Build esp32dev_b3_edge_auth_compile; no forwarding/Responder.
// Phase 1 keeps DPT/2 TCP/SSH/HTTPS backward-compatible and reports Auth on
// Serial. Reserved *_wire_compile MUST NOT be uploaded until Core Phase 2.

// Lite HTTP profile: no new domain, no dedicated responder, no second VPS.
// Keep the existing Edge:2252, pinned host key and test account.
// Keep PROBE_DEEP_AUTH_ONLY=0 so SSH can forward to an HTTP download server.
// REPLACE old loopback defaults in your ignored local file with:
//   PROBE_DEEP_REMOTE_HOST "speedtest.tele2.net"
//   PROBE_DEEP_REMOTE_PORT 80
// The code GETs /1MB.zip, Range 0-8191, twice over one authenticated SSH
// session with a 5-second dwell; it validates 200/206 and 8192 BODY bytes.
// This third-party endpoint may fail independently. It is a path witness,
// not proof of full NPV customer egress or censorship.
// An exact per-account SSHD PermitOpen may need explicit approval.
// The build does not reveal secrets or change Core or SSHD.
