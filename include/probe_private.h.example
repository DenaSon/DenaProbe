#pragma once

// Create LOCAL include/probe_private.h from this example.
// Never commit your real Edge hostname/IP, Core details or credentials.
#define PROBE_EDGE_HOST "CHANGE_ME_EDGE_HOST"
#define PROBE_EDGE_PORT 2252

// On many ESP32 DevKit boards the small controllable LED is GPIO2.
// Some ESP32-D0WD boards have no onboard programmable LED or use another pin.
// Change these in the ignored local file if necessary.
#define PROBE_LED_PIN 2
#define PROBE_LED_ACTIVE_LOW 0

// R3 Phase 2: opt-in only. The default remains OFF, including for all users.
// Use a dedicated monitoring-only SSH key and restricted forwarding account.
// Do NOT paste customer passwords or private keys into Git or an issue.
#define PROBE_DEEP_ENABLED 0
#define PROBE_DEEP_USER ""
#define PROBE_DEEP_PRIVATE_KEY_B64 "" // LOCAL ignored file ONLY
#define PROBE_DEEP_REMOTE_HOST "127.0.0.1"
#define PROBE_DEEP_REMOTE_PORT 18180
#define PROBE_DEEP_SAMPLE_BYTES 16384UL
#define PROBE_DEEP_DWELL_MS 20000UL
#define PROBE_DEEP_EVERY_N_CYCLES 2
