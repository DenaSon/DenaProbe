{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denaprobe.local/contracts/dpt/v1/ack.schema.json",
  "title": "DPT/1 durable ingestion ACK",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "b",
    "q",
    "ack"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "b": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "q": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    }
  }
}
